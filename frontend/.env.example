# Point these at your FastAPI backend once it's deployed.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# Set to "true" to enable a local data simulator that generates fake
# readings when the backend is not reachable (standalone dev only).
# Leave unset or "false" when using mock-data/ or a real ECU.
VITE_ENABLE_LOCAL_SIMULATOR=false
